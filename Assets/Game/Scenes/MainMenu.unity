      m_Calls: []
  m_text: "<b>\u0417\u0430\u0434\u0430\u043D\u0438\u044F \u0432 \u0430\u0439\u044B\u043B\u0435</b>\n<size=85%><color=#C9BFA6>\u2022 <b>\u0410\u0439\u0431\u0435\u043A</b> \u2014 \u0442\u0432\u043E\u0439 \u0434\u0440\u0443\u0433 \u0438 \u0433\u0438\u0434: \u043F\u043E\u0437\u0434\u043E\u0440\u043E\u0432\u0430\u0439\u0441\u044F, \u043F\u043E\u043C\u043E\u0433\u0430\u0439 \u0436\u0438\u0442\u0435\u043B\u044F\u043C \u0438 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0439 \u0435\u043C\u0443 \u043E\u0431 \u0443\u0441\u043F\u0435\u0445\u0430\u0445\n\u2022 <b>\u0411\u043E\u0437 \u04AF\u0439</b> \u2014 \u043F\u043E\u043C\u043E\u0433\u0438 \u0430\u043A\u0441\u0430\u043A\u0430\u043B\u0443 \u0441\u043E\u0431\u0440\u0430\u0442\u044C \u044E\u0440\u0442\u0443: \u043A\u0435\u0440\u0435\u0433\u0435, \u0443\u0443\u043A, \u0442\u04AF\u043D\u0434\u04AF\u043A, \u043A\u0438\u0439\u0438\u0437\n\u2022 <b>\u0427\u04AF\u043A\u04E9 \u0430\u0442\u0443\u0443</b> \u2014 \u0441\u044B\u0433\u0440\u0430\u0439 \u0441 \u0434\u0435\u0442\u044C\u043C\u0438, \u0432\u044B\u0431\u0435\u0439 \u043A\u043E\u0441\u0442\u043E\u0447\u043A\u0438 \u0438\u0437 \u043A\u0440\u0443\u0433\u0430\n\u2022 <b>\u0423\u043B\u0443\u0442\u0442\u0443\u043A \u0442\u0430\u043C\u0430\u043A</b> \u2014 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u044C \u0441 \u044D\u0436\u0435 \u0431\u043E\u043E\u0440\u0441\u043E\u043A \u0438 \u043A\u0443\u0443\u0440\u0434\u0430\u043A\n\n\u0417\u0430 \u043A\u0430\u0436\u0434\u043E\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u0435 \u2014 XP. \u041F\u043E\u0441\u043B\u0435 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u2014 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439 \u0432\u043E\u043F\u0440\u043E\u0441 \u043E \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u0435.\nXP \u0442\u0440\u0430\u0442\u0438\u0442\u0441\u044F \u043D\u0430 <b>\u0431\u0430\u0437\u0430\u0440\u0435</b> \u0443 \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0430 \u0410\u0441\u0430\u043D\u0430: \u043E\u0434\u0435\u0436\u0434\u0430, \u0448\u0430\u043F\u043A\u0438, \u0443\u043C\u0435\u043D\u0438\u044F, \u043F\u0451\u0441 \u0438 \u043A\u043E\u043D\u044C.\n\u0410 \u0435\u0449\u0451: \u043A\u043E\u043C\u0443\u0437 \u0441 \u041D\u0443\u0440\u043B\u0430\u043D\u043E\u043C, \u0448\u044B\u0440\u0434\u0430\u043A \u0441 \u0410\u043F\u043E\u0439, \u0441\u043A\u0430\u0447\u043A\u0438 \u0430\u0442 \u0447\u0430\u0431\u044B\u0448, \u0440\u044B\u0431\u0430\u043B\u043A\u0430 \u0438 \u0431\u0435\u0440\u043A\u0443\u0442 \u0411\u043E\u043B\u043E\u0442\u0430.</color></size>"
  m_isRightToLeft: 0
