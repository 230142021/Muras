--- !u!114 &412485016
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 412485014}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6da1b7e2f74244d2c899fcfeacb47cd6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LocalizedText
  ru: "<color=#E8B04A><b>W A S D</b></color>   \u0445\u043E\u0434\u044C\u0431\u0430\n<color=#E8B04A><b>Shift</b></color>   \u0431\u0435\u0433\n<color=#E8B04A><b>Space</b></color>   \u043F\u0440\u044B\u0436\u043E\u043A\n<color=#E8B04A><b>\u041F\u041A\u041C + \u043C\u044B\u0448\u044C</b></color>   \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u044C \u043A\u0430\u043C\u0435\u0440\u0443\n<color=#E8B04A><b>\u041A\u043E\u043B\u0435\u0441\u043E</b></color>   \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u044C \u043A\u0430\u043C\u0435\u0440\u0443\n<color=#E8B04A><b>E</b></color>   \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C / \u0432\u0437\u044F\u0442\u044C\n<color=#E8B04A><b>1 2 3</b></color>   \u043E\u0442\u0432\u0435\u0442\u044B \u0432 \u0432\u043E\u043F\u0440\u043E\u0441\u0430\u0445\n<color=#E8B04A><b>H</b></color>   \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430-\u0441\u0442\u0440\u0435\u043B\u043A\u0430\n<color=#E8B04A><b>C</b></color>   \u0433\u0430\u0440\u0434\u0435\u0440\u043E\u0431 (\u043A\u0443\u043F\u043B\u0435\u043D\u043D\u0430\u044F \u043E\u0434\u0435\u0436\u0434\u0430)\n<color=#E8B04A><b>J</b></color>   \u0441\u04E9\u0437\u0434\u04AF\u043A: \u0441\u043B\u043E\u0432\u0430\u0440\u044C \u0438 \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044F\n<color=#E8B04A><b>I / Tab</b></color>   \u043A\u0430\u043F\u0447\u044B\u043A: \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C\n<color=#E8B04A><b>T</b></color>   \u0443\u0441\u043A\u043E\u0440\u0438\u0442\u044C \u0432\u0440\u0435\u043C\u044F \u0441\u0443\u0442\u043E\u043A\n<color=#E8B04A><b>Esc</b></color>   \u043F\u0430\u0443\u0437\u0430"
  en: "<color=#E8B04A><b>W A S D</b></color>   walk\n<color=#E8B04A><b>Shift</b></color>   run\n<color=#E8B04A><b>Space</b></color>   jump\n<color=#E8B04A><b>RMB + mouse</b></color>   rotate camera\n<color=#E8B04A><b>Wheel</b></color>   zoom camera\n<color=#E8B04A><b>E</b></color>   talk / pick up\n<color=#E8B04A><b>1 2 3</b></color>   quiz answers\n<color=#E8B04A><b>H</b></color>   hint arrow\n<color=#E8B04A><b>C</b></color>   wardrobe (clothes you bought)\n<color=#E8B04A><b>J</b></color>   \u0441\u04E9\u0437\u0434\u04AF\u043A: dictionary and achievements\n<color=#E8B04A><b>I / Tab</b></color>   kapchyk: inventory\n<color=#E8B04A><b>T</b></color>   speed up the time of day\n<color=#E8B04A><b>Esc</b></color>   pause"
